# Runtime mode: development, test, or production. Defaults to development.
NODE_ENV=

# Required: MongoDB Atlas or replica-set/sharded-cluster connection URI.
MONGO_URI=
# Optional MongoDB driver/startup controls with production-safe defaults.
MONGO_SERVER_SELECTION_TIMEOUT_MS=
MONGO_MAX_POOL_SIZE=
MONGO_RETRY_ATTEMPTS=
MONGO_RETRY_DELAY_MS=
# Required: a randomly generated signing secret of at least 32 characters.
JWT_SECRET=

# Required: frontend/application URL that consumes activation links.
ACCOUNT_ACTIVATION_URL=
# Required: frontend/application URL that consumes employee invitation links.
EMPLOYEE_INVITATION_URL=

# Required SMTP transport host and sender.
SMTP_HOST=
# Optional; defaults to 587, or 465 when SMTP_SECURE=true.
SMTP_PORT=
# Optional; defaults to false. Use true for implicit TLS, normally on port 465.
SMTP_SECURE=
# Optional; defaults to true and requires STARTTLS when SMTP_SECURE=false.
SMTP_REQUIRE_TLS=
# Required plain sender address, for example no-reply@example.com.
SMTP_FROM=
# Optional authentication pair; set both or leave both blank.
SMTP_USER=
SMTP_PASSWORD=

# Optional: TCP port; defaults to 3000.
PORT=
# Optional number of explicitly trusted reverse-proxy hops; defaults to 0.
TRUST_PROXY_HOPS=
# Optional in-memory upload limit in bytes; defaults to 10485760 (10 MiB), max 104857600.
FILE_MAX_SIZE_BYTES=
# Optional: comma-separated HTTPS origins, no paths or trailing slashes.
# HTTP is accepted only for localhost development.
# Blank disables browser cross-origin access.
CORS_ORIGIN=

# Optional Google OAuth: set all four together, or leave all blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Full HTTPS backend callback URL ending in /auth/google/callback.
GOOGLE_CALLBACK_URL=
# Frontend HTTPS origin; HTTP is accepted only on localhost.
FRONT_URI=

# Required for file operations: private S3 bucket and region; blank disables storage.
AWS_BUCKET_NAME=
AWS_REGION=
# Optional credential pair; blank uses the AWS SDK default credential chain (IAM roles).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional session token for temporary credentials; requires the credential pair above.
AWS_SESSION_TOKEN=
